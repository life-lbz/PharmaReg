APP_ENV=local
APP_NAME=PharmaReg
DEBUG=true

DATABASE_URL=mysql+pymysql://root:pharmareg@127.0.0.1:3306/pharmareg?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

TENANT_MODE=single

LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-14b

EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=http://127.0.0.1:8081
# 本地落地：规格推荐 bge-reranker-v2-m3，本地模型仓以 bge-reranker-large 同族替代
RERANK_MODEL=bge-reranker-large
RERANK_BASE_URL=http://127.0.0.1:8081

FEEDBACK_EVAL_SAMPLE=100
